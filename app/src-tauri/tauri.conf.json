{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hackerman",
  "version": "0.8.0",
  "identifier": "dev.hackerman.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hackerman",
        "visible": false,
        "width": 1120,
        "height": 720,
        "minWidth": 860,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Share one keyboard and mouse across several computers",
    "licenseFile": "../../LICENSE-MIT",
    "windows": {
      "nsis": { "installMode": "currentUser", "installerHooks": "windows/hooks.nsh" }
    }
  }
}
